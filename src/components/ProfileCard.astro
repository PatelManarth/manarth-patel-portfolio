---
import '../styles/profile-effects.css';
import '../styles/profile-card.css';
---
<aside class="profile-card" aria-label="Manarth Patel professional profile">
  <div class="profile-card__media" data-profile-media>
    <div class="profile-card__matrix" aria-hidden="true"></div>
    <div class="profile-card__orbit profile-card__orbit--outer" aria-hidden="true"></div>
    <div class="profile-card__orbit profile-card__orbit--inner" aria-hidden="true"></div>
    <div class="profile-card__radar" aria-hidden="true"></div>
    <img
      class="profile-card__portrait"
      src="/assets/img/profile-placeholder-latest.png"
      alt="Portrait of Manarth Patel"
      width="500"
      height="500"
      loading="eager"
      decoding="async"
    />
    <div class="profile-card__portrait-overlay" aria-hidden="true">
      <span class="profile-card__node profile-card__node--one"></span>
      <span class="profile-card__node profile-card__node--two"></span>
      <span class="profile-card__node profile-card__node--three"></span>
      <span class="profile-card__node profile-card__node--four"></span>
    </div>
    <div class="profile-card__portrait-texture" aria-hidden="true"></div>
    <div class="profile-card__scan" aria-hidden="true"></div>
    <div class="profile-card__corner profile-card__corner--tl" aria-hidden="true"></div>
    <div class="profile-card__corner profile-card__corner--br" aria-hidden="true"></div>
    <span class="profile-card__signal">Professional Profile</span>
  </div>
  <div class="profile-card__body">
    <p class="profile-card__eyebrow">Manarth Patel</p>
    <h2>Cyber Security Engineer</h2>
    <p>Experience across security operations, IAM, vulnerability management, infrastructure support and technical problem-solving, supported by a background in backend development and application technologies.</p>
    <dl class="profile-card__facts">
      <div><dt>Location</dt><dd>Greater Toronto Area, Ontario, Canada</dd></div>
      <div><dt>Experience</dt><dd>5+ years across security, support, development and infrastructure</dd></div>
      <div><dt>Focus</dt><dd>Security operations, IAM, vulnerability management and infrastructure security</dd></div>
      <div><dt>Availability</dt><dd>Remote, hybrid and onsite across Canada</dd></div>
    </dl>
    <div class="profile-card__links">
      <a class="button button--primary" href="https://www.linkedin.com/in/manarthpatel/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
      <a class="button" href="https://github.com/PatelManarth" target="_blank" rel="noreferrer">GitHub ↗</a>
    </div>
  </div>
</aside>
