---
import { navigation } from '../data/navigation';
const { pathname = '/' } = Astro.props;
const active = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---
<header class="site-header">
  <nav class="nav shell" aria-label="Primary navigation">
    <a class="brand" href="/" aria-label="Manarth Patel home">
      <span class="brand-name">Manarth Patel</span>
      <span class="brand-subtitle brand-subtitle--desktop">Cyber Security Engineer</span>
      <span class="brand-subtitle brand-subtitle--mobile">Security Engineer</span>
    </a>

    <div class="nav-actions">
      <button class="search-trigger" type="button" data-search-open aria-label="Search website">
        <span class="nav-control__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
        </span>
        <span class="nav-control__label">Search</span>
        <kbd>Ctrl K</kbd>
      </button>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch colour theme">
        <span class="nav-control__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="7"></circle><path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path></svg>
        </span>
        <span class="nav-control__label">Theme</span>
        <strong data-theme-name>Blue</strong>
      </button>
      <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-menu" aria-label="Open navigation menu">
        <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
        <span class="nav-control__label">Menu</span>
      </button>
    </div>

    <div class="nav-menu" id="site-menu" data-menu>
      {navigation.map((item) => item.children ? (
        <details class="nav-group" open={active(item.href)}>
          <summary class:list={[active(item.href) && 'is-active']}>{item.label}</summary>
          <div class="nav-dropdown">
            {item.children.map((child) => <a class:list={[active(child.href) && 'is-active']} href={child.href}>{child.label}</a>)}
          </div>
        </details>
      ) : (
        <a class:list={[active(item.href) && 'is-active', item.label === 'Contact' && 'nav-contact']} href={item.href}>{item.label}</a>
      ))}
    </div>
  </nav>
</header>
