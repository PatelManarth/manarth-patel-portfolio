---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { skillHref } from '../../data/skills';

const plannedSkills = [
  ['SIEM', 'security-monitoring'],
  ['Detection Engineering', 'indicator-analysis'],
  ['Incident Response', 'incident-response-support'],
  ['IAM', 'identity-access-management'],
  ['Vulnerability Management', 'vulnerability-management'],
  ['Cloud Security', 'cloud-security-fundamentals'],
  ['Network Monitoring', 'network-security'],
  ['Digital Forensics', 'incident-investigation'],
  ['Automation', 'python']
];
---
<BaseLayout title="Cybersecurity Learning Lab | Manarth Patel" description="A planned, evidence-driven cybersecurity learning programme documenting practical security work, lessons, and sanitized technical evidence.">
  <section class="section shell page-hero">
    <span class="eyebrow">Planned Learning Programme</span>
    <h1 class="page-title">Cybersecurity Learning Lab</h1>
    <p class="page-intro">A planned, evidence-driven programme documenting practical cybersecurity work from foundational architecture through monitoring, investigation, remediation, and integrated incident response.</p>
    <p class="page-support">Each stage will be shared through walkthroughs, troubleshooting notes, queries, diagrams, and sanitized evidence to support students and professionals stepping into cybersecurity.</p>

    <div class="content-grid content-grid--two">
      <article class="content-card content-card--accent">
        <span class="content-card__label">Current status</span>
        <h2>Planned · 0% · Evidence pending</h2>
        <p>No lab will be marked in progress, completed, or portfolio-ready until the corresponding work and evidence exist.</p>
      </article>
      <article class="content-card" id="planned-coverage">
        <span class="content-card__label">Planned coverage</span>
        <h2>Practical cybersecurity domains</h2>
        <div class="tags">
          {plannedSkills.map(([label, slug]) => <a href={skillHref(slug)}>{label}</a>)}
        </div>
      </article>
    </div>

    <div class="hero-actions section-actions">
      <a class="button button--primary" href="/blog/">Read the Learning Blog</a>
      <a class="button" href="/projects/">View Completed Academic Projects</a>
      <a class="button" href="/skills/">Explore Related Skills</a>
    </div>
  </section>
</BaseLayout>
